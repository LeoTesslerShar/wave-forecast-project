# Copy to .env and fill in. Hard rule 4: no real values committed, ever.

DATABASE_URL=postgresql+asyncpg://surf:surf@postgres:5432/surf
DATABASE_URL_SYNC=postgresql+psycopg2://surf:surf@postgres:5432/surf
REDIS_URL=redis://redis:6379/0

OPEN_METEO_MARINE_BASE_URL=https://marine-api.open-meteo.com/v1/marine
OPEN_METEO_FORECAST_BASE_URL=https://api.open-meteo.com/v1/forecast
ISRAMAR_HADERA_URL=https://isramar.ocean.org.il/isramar2009/station/data/Hadera_Hs_Per.json

HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3

FORECAST_HOURS_AHEAD=72
BACKFILL_MAX_DAYS=3
INGESTION_SCHEDULE_MINUTES=180

LOG_LEVEL=INFO
